<?xml version="1.0" encoding="utf-8"?>
<!-- 拼写考试（二级页，进阶模式）：随机 20 词，看中文释义拼出外语词。
     与「复习」页的自评模式区别：这里要真的打对字，是给自己出的题。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <include
        android:id="@+id/headerBar"
        layout="@layout/view_sub_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/examProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/ink2"
            android:textSize="13sp"
            tools:text="第 3 / 20 题" />

        <TextView
            android:id="@+id/examBook"
            style="@style/ShiyuSubtitle"
            android:textSize="12sp"
            tools:text="CET4" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/examScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- 题目卡 -->
            <LinearLayout
                android:id="@+id/questionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:minHeight="190dp"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/examLabel"
                    style="@style/ShiyuSubtitle"
                    android:textSize="12sp"
                    tools:text="看释义，拼出英文单词" />

                <TextView
                    android:id="@+id/examPrompt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:textColor="@color/ink"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:text="突然地" />

                <TextView
                    android:id="@+id/examHintLine"
                    style="@style/ShiyuSubtitle"
                    android:layout_marginTop="10dp"
                    android:textSize="12sp"
                    tools:text="A1 · n." />
            </LinearLayout>

            <!-- 作答 -->
            <EditText
                android:id="@+id/examInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/mute"
                android:textSize="17sp"
                android:hint="@string/exam_hint" />

            <TextView
                android:id="@+id/examResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="答错了，正确答案是「abruptly」" />

            <TextView
                android:id="@+id/examSubmit"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_clay"
                android:gravity="center"
                android:text="@string/exam_submit"
                android:textColor="@color/cream"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- 结算 -->
            <LinearLayout
                android:id="@+id/resultPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/exam_done_title"
                    android:textColor="@color/ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/scoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="serif"
                    android:textColor="@color/clay"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    tools:text="17 / 20" />

                <TextView
                    android:id="@+id/scoreComment"
                    style="@style/ShiyuSubtitle"
                    android:layout_marginTop="8dp"
                    tools:text="很棒，这批词掌握得不错" />

                <TextView
                    android:id="@+id/btnExamAgain"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_btn_ghost"
                    android:gravity="center"
                    android:text="@string/exam_again"
                    android:textColor="@color/clay"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
