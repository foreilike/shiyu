<?xml version="1.0" encoding="utf-8"?>
<!--
  对话（Tab 3，中央麦克风指向这里）。
  设计稿的麦克风直接进实时语音，但工程里还有「回合制场景对话」这一整套能力，
  所以这里做成对话中心：实时语音是置顶的重色块 hero，场景练习列在下面，两条路都不丢。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">
            <TextView
                style="@style/ShiyuTitle"
                android:text="@string/talk_title" />
            <TextView
                style="@style/ShiyuSubtitle"
                android:layout_marginTop="2dp"
                android:text="@string/talk_sub" />
        </LinearLayout>

        <!-- 实时语音 hero -->
        <RelativeLayout
            android:id="@+id/btnVoiceRealtime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_voice_card"
            android:clickable="true"
            android:focusable="true"
            android:padding="18dp">

            <LinearLayout
                android:id="@+id/voiceHeroTexts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="48dp"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.14"
                    android:text="@string/voice_kicker"
                    android:textColor="@color/gold"
                    android:textSize="10sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="serif"
                    android:text="@string/voice_entry_title"
                    android:textColor="@color/cream"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/voicePartner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FFB9A894"
                    android:textSize="12sp"
                    tools:text="AI 语伴 Yuki 在线 · 像朋友一样聊天" />
            </LinearLayout>

            <com.shiyu.app.ui.widget.MiniWaveView
                android:layout_width="match_parent"
                android:layout_height="26dp"
                android:layout_below="@id/voiceHeroTexts"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="48dp" />

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_mic_fab"
                android:contentDescription="@string/voice_entry_title"
                android:padding="7dp"
                android:src="@drawable/ic_mic"
                app:tint="@color/cream" />
        </RelativeLayout>

        <TextView
            android:id="@+id/scenarioLabel"
            style="@style/ShiyuSubtitle"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="6dp"
            android:letterSpacing="0.06"
            android:text="@string/talk_scenarios"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/scenarioList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="104dp"
            android:scrollbars="none" />
    </LinearLayout>

    <include
        android:id="@+id/bottomNavBar"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</FrameLayout>
