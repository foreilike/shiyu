<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_voice_card">

    <!-- 主对话层 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部：返回 + 语伴 + 计时 -->
        <LinearLayout
            android:id="@+id/voiceTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/voice_back_home"
                android:src="@drawable/ic_nav_chat"
                app:tint="@color/cream" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/voicePartnerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="yoyo"
                    android:textColor="@color/cream"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/voicePartnerSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="AI 语伴 · 日语"
                    android:textColor="#A79684"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/voiceTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="#C8B8A5"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 波形 + 状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <LinearLayout
                android:id="@+id/waveContainer"
                android:layout_width="300dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/voiceState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:paddingTop="10dp"
                android:text="@string/voice_state_idle"
                android:textColor="@color/gold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/voiceGateHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="@string/voice_gated"
                android:textColor="#A79684"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 字幕流 -->
        <ScrollView
            android:id="@+id/transcriptScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:id="@+id/transcriptContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- 控制区 -->
        <LinearLayout
            android:id="@+id/voiceControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/btnCc"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="字幕"
                android:src="@drawable/ic_chart"
                app:tint="@color/cream" />

            <ImageButton
                android:id="@+id/btnMic"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_mic_clay"
                android:contentDescription="@string/voice_listening"
                android:padding="22dp"
                android:src="@drawable/ic_nav_chat"
                app:tint="@color/cream" />

            <ImageButton
                android:id="@+id/btnHint"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="提示"
                android:src="@drawable/ic_nav_study"
                app:tint="@color/cream" />
        </LinearLayout>
    </LinearLayout>

    <!-- 准备层 -->
    <LinearLayout
        android:id="@+id/readyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_voice_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <TextView
            android:id="@+id/readyAvatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_soft"
            android:gravity="center"
            android:textColor="@color/clay"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="y" />

        <TextView
            android:id="@+id/readyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:paddingTop="14dp"
            android:textColor="@color/cream"
            android:textSize="21sp"
            android:textStyle="bold"
            tools:text="和 yoyo 聊聊天" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="实时语音对话 · 说完自动断句\nAI 语伴会先开口，轮到你时说话即可"
            android:textColor="#A79684"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnStartVoice"
            android:layout_width="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_height="50dp"
            style="@style/ShiyuButton.Primary"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:text="@string/voice_start"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 总结层 -->
    <LinearLayout
        android:id="@+id/summaryOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/voice_summary_title"
            android:textColor="@color/cream"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/dark2"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/sumTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="00:00"
                    android:textColor="#E8C9A8"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_summary_time"
                    android:textColor="#A79684"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/dark2"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/sumTurns"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="0"
                    android:textColor="#E8C9A8"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_summary_turns"
                    android:textColor="#A79684"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="26dp">

            <Button
                android:id="@+id/btnAgain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/ShiyuButton.Primary"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/voice_again"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                style="@style/ShiyuButton.OnDark"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/voice_back_home"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
