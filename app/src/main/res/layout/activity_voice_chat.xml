<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_voice_card">

    <!-- 主对话层 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部：返回 + 语伴 + 计时 -->
        <LinearLayout
            android:id="@+id/voiceTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/voice_back_home"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/cream" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/voicePartnerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="yoyo"
                    android:textColor="@color/cream"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/voicePartnerSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="AI 语伴 · 日语"
                    android:textColor="#A79684"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/voiceTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="00:00"
                android:textColor="#C8B8A5"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 波形 + 状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="20dp">

            <LinearLayout
                android:id="@+id/waveContainer"
                android:layout_width="300dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/voiceState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.12"
                android:paddingTop="10dp"
                android:text="@string/voice_state_idle"
                android:textColor="@color/gold"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/voiceGateHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="6dp"
                android:text="@string/voice_gated"
                android:textColor="#A79684"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 字幕流 -->
        <ScrollView
            android:id="@+id/transcriptScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:id="@+id/transcriptContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!--
          底部区：打字输入行 + 控制栏。
          包一层是为了让 BaseActivity 把「导航栏/键盘」的高度统一还给这里 ——
          edge-to-edge 下 adjustResize 不生效，不手动吃 inset 的话键盘会直接盖住输入框。
        -->
        <LinearLayout
            android:id="@+id/bottomBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!--
          打字输入：平时隐藏，点「打字」才出现。
          走协议的 conversation.item.create（input_text），和语音共用同一条会话 ——
          AI 的回复照样带语音和字幕，不需要另开链路。
        -->
        <LinearLayout
            android:id="@+id/typeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <!--
              收起按钮：打字时控制栏被隐藏，而「打字」按钮就在控制栏里 ——
              没有这个键，用户展开输入行之后就关不掉了（实际踩到）。
            -->
            <TextView
                android:id="@+id/btnTypeClose"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_pill_dark"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/voice_type_close"
                android:textColor="@color/cream"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/typeInput"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:hint="@string/voice_type_hint"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/mute"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnTypeSend"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_btn_clay"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:text="@string/voice_type_send"
                android:textColor="@color/cream"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!--
          控制区。每个按钮都是「图标 + 文字」。
          之前只有裸图标，而且图标是错配的：麦克风画的是对话气泡、字幕画的是图表三横线、
          提示画的是学士帽 —— 等于让人猜。加文字标签是最省事的可懂性提升。
        -->
        <LinearLayout
            android:id="@+id/voiceControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:id="@+id/btnCc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <ImageView
                    android:id="@+id/ccIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_subtitles"
                    app:tint="@color/cream" />
                <TextView
                    android:id="@+id/ccLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/voice_btn_cc"
                    android:textColor="@color/cream"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_hint"
                    app:tint="@color/cream" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/voice_btn_hint"
                    android:textColor="@color/cream"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnMic"
                android:layout_width="82dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">
                <FrameLayout
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_mic_clay">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/voice_btn_interrupt"
                        android:src="@drawable/ic_mic"
                        app:tint="@color/cream" />
                </FrameLayout>
                <TextView
                    android:id="@+id/micLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/voice_btn_interrupt"
                    android:textColor="@color/cream"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_keyboard"
                    app:tint="@color/cream" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/voice_btn_type"
                    android:textColor="@color/cream"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnHangup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_end_call"
                    app:tint="@color/cream" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/voice_btn_end"
                    android:textColor="@color/cream"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- 准备层 -->
    <LinearLayout
        android:id="@+id/readyOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_voice_card"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <TextView
            android:id="@+id/readyAvatar"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_soft"
            android:gravity="center"
            android:textColor="@color/clay"
            android:textSize="28sp"
            android:textStyle="bold"
            tools:text="y" />

        <TextView
            android:id="@+id/readyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:paddingTop="14dp"
            android:textColor="@color/cream"
            android:textSize="21sp"
            android:textStyle="bold"
            tools:text="和 yoyo 聊聊天" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="8dp"
            android:text="@string/voice_ready_sub"
            android:textColor="#A79684"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnStartVoice"
            android:layout_width="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_height="50dp"
            style="@style/ShiyuButton.Primary"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:text="@string/voice_start"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- 总结层 -->
    <LinearLayout
        android:id="@+id/summaryOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dark"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:text="@string/voice_summary_title"
            android:textColor="@color/cream"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/dark2"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/sumTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="00:00"
                    android:textColor="#E8C9A8"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_summary_time"
                    android:textColor="#A79684"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@color/dark2"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:id="@+id/sumTurns"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="0"
                    android:textColor="#E8C9A8"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voice_summary_turns"
                    android:textColor="#A79684"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="26dp">

            <Button
                android:id="@+id/btnAgain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/ShiyuButton.Primary"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/voice_again"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnExit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                style="@style/ShiyuButton.OnDark"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/voice_back_home"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
