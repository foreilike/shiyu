<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <!-- 顶部：问候 + Streak + 图表入口 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:text="@string/study_title"
            android:textColor="@color/ink"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_soft"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="连续 7 天"
            android:textColor="@color/clay"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnChart"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/chart_entry"
            android:src="@drawable/ic_chart"
            android:tint="@color/clay" />
    </LinearLayout>

    <include
        android:id="@+id/langBar"
        layout="@layout/view_lang_bar" />

    <TextView
        android:id="@+id/progressText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="4dp"
        android:textColor="@color/mute"
        android:textSize="12sp" />

    <!-- 学习卡片（拾语：白卡描边、衬线大词） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/cardFront"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cardFrontSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="6dp"
                android:textColor="@color/clay"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/cardMeaning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="18dp"
                android:textColor="@color/ink"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cardBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="20dp"
                android:textColor="@color/ink"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/cardBackSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="4dp"
                android:textColor="@color/mute"
                android:visibility="gone" />

            <TextView
                android:id="@+id/judgeResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="14dp"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 四色评分键（SM-2） -->
        <LinearLayout
            android:id="@+id/ratingRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="14dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnQ2"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:text="@string/quality_forgot"
                android:textColor="@color/bad_red"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnQ3"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:text="@string/quality_vague"
                android:textColor="@color/clay"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnQ4"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_ghost"
                android:text="@string/quality_recalled"
                android:textColor="@color/lang_en"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnQ5"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_clay"
                android:text="@string/quality_easy"
                android:textColor="@color/cream"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 输入区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <EditText
            android:id="@+id/answerInput"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="@string/answer_input"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/ink"
            android:textColorHint="@color/mute"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnConfirm"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_btn_clay"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:text="@string/confirm_answer"
            android:textColor="@color/cream"
            android:textSize="14sp" />
    </LinearLayout>

    <include
        android:id="@+id/bottomNavBar"
        layout="@layout/view_bottom_nav" />
</LinearLayout>
