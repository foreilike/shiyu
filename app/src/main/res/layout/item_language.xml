<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/langCode"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_round12"
        android:gravity="center"
        android:textColor="@color/card"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:backgroundTint="@color/lang_ja"
        tools:text="JA" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/langName"
            style="@style/ShiyuCardTitle"
            android:textSize="16sp"
            tools:text="日语" />
        <TextView
            android:id="@+id/langMeta"
            style="@style/ShiyuSubtitle"
            android:layout_marginTop="2dp"
            tools:text="138 张卡片 · 5 个场景" />
    </LinearLayout>

    <TextView
        android:id="@+id/langBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_white"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textSize="11sp"
        tools:text="即将支持" />
</LinearLayout>
