<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/badgeIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle"
        android:contentDescription="@null"
        android:padding="9dp"
        tools:backgroundTint="@color/clay_soft"
        tools:src="@drawable/ic_flame"
        tools:tint="@color/clay" />

    <TextView
        android:id="@+id/badgeName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:gravity="center"
        android:textColor="@color/ink"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="七日之火" />

    <TextView
        android:id="@+id/badgeDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:lineSpacingExtra="-1dp"
        android:minLines="2"
        android:textColor="@color/mute"
        android:textSize="10sp"
        tools:text="连续打卡 7 天" />

    <TextView
        android:id="@+id/badgeProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="@color/clay"
        android:textSize="10.5sp"
        tools:text="3 / 7" />
</LinearLayout>
