<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">
            <TextView
                style="@style/ShiyuTitle"
                android:text="@string/langs_title" />
            <TextView
                style="@style/ShiyuSubtitle"
                android:layout_marginTop="2dp"
                android:text="@string/langs_sub" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="104dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/labelCurrent"
                    style="@style/ShiyuSubtitle"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.06"
                    android:text="@string/langs_current"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_cont_card"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">
                    <TextView
                        android:id="@+id/curCode"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_round12"
                        android:gravity="center"
                        android:textColor="@color/card"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        tools:backgroundTint="@color/lang_ja"
                        tools:text="JA" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/curName"
                            style="@style/ShiyuCardTitle"
                            tools:text="日语" />
                        <TextView
                            android:id="@+id/curMeta"
                            style="@style/ShiyuSubtitle"
                            android:layout_marginTop="3dp"
                            tools:text="待复习 18 · 已掌握 24" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/ShiyuSubtitle"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.06"
                    android:text="@string/langs_available"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/langContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    style="@style/ShiyuSubtitle"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:letterSpacing="0.06"
                    android:text="@string/langs_coming"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/comingContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <include
        android:id="@+id/bottomNavBar"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom" />
</FrameLayout>
