<?xml version="1.0" encoding="utf-8"?>
<!--
  拾语 App 图标 · 前景层
  主形 = 陶土对话泡 + 三段声波：「开口说话」是这个产品的核心，中间一根最高，
  读作一句话的语调起落。配色取自设计稿的陶土主色，不用高饱和亮色，
  放在桌面上是克制的一格。

  全部图元落在 108 画布中央 72x72 的安全区内（x 23–85、y 24–84，安全区为 18–90），
  圆形 / 方形 / squircle 各种启动器裁切都切不到主形。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 对话泡（圆角矩形 + 左下尾巴，一笔连通） -->
    <path android:pathData="M40,24 H68 A17,17 0 0 1 85,41 V55 A17,17 0 0 1 68,72 H60 L47,84 L52,72 H40 A17,17 0 0 1 23,55 V41 A17,17 0 0 1 40,24 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="23"
                android:startY="24"
                android:endX="85"
                android:endY="84">
                <item android:offset="0" android:color="#FFB85C31" />
                <item android:offset="1" android:color="#FF7E3A1B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 声波三段：高 15 / 27 / 19，左右同色，中间提亮 -->
    <path
        android:fillColor="#FFF3E4D2"
        android:pathData="M41,41 a3.75,3.75 0 0 1 3.75,3.75 v7.5 a3.75,3.75 0 0 1 -7.5,0 v-7.5 A3.75,3.75 0 0 1 41,41 Z" />
    <path
        android:fillColor="#FFFFFAF3"
        android:pathData="M54,35 a3.75,3.75 0 0 1 3.75,3.75 v19.5 a3.75,3.75 0 0 1 -7.5,0 v-19.5 A3.75,3.75 0 0 1 54,35 Z" />
    <path
        android:fillColor="#FFF3E4D2"
        android:pathData="M67,39 a3.75,3.75 0 0 1 3.75,3.75 v11.5 a3.75,3.75 0 0 1 -7.5,0 v-11.5 A3.75,3.75 0 0 1 67,39 Z" />
</vector>
