<?xml version="1.0" encoding="utf-8"?>
<!--
  拾语 App 图标 · 背景层
  暖纸底 + 极轻的陶土向暖，保持设计稿"安静的纸"的基调，
  不用高饱和色块，这样图标放在桌面上和其它 App 并排时是克制的一格。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="315"
        android:startColor="#FFFDFBF7"
        android:centerColor="#FFF7EFE4"
        android:endColor="#FFEDDCC9" />
</shape>
