<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Shiyu" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/clay</item>
        <item name="colorPrimaryDark">@color/clay_deep</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 设置页输入框（拾语：白底细描边小圆角） -->
    <style name="FieldInput" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/mute</item>
        <item name="android:textSize">13sp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- 设置页小按钮（显示/隐藏 Key、测试连接） -->
    <style name="MiniButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_btn_ghost</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/clay</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
</resources>
