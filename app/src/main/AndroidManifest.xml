<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 要用系统 TTS（发音表 / 对话逐句 / 复习页单词朗读）必须先声明查询，
         否则部分 ROM 上引擎包不可见，TextToSpeech 静默按空实现走、一点声音都没有 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Shiyu">

        <!-- Tab 1：今日（启动页） -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tab 2：课程 -->
        <activity
            android:name=".ui.langs.LanguagesActivity"
            android:exported="false" />

        <!-- Tab 3：对话中心 -->
        <activity
            android:name=".ui.chat.ChatListActivity"
            android:exported="false" />

        <!-- Tab 4：复习 -->
        <activity
            android:name=".ui.review.ReviewActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tab 5：我的 -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />

        <!-- 二级页 -->
        <activity
            android:name=".ui.history.HistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ui.history.HistoryDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.chart.ChartActivity"
            android:exported="false" />
        <activity
            android:name=".ui.chat.ChatActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|smallestScreenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.voice.VoiceChatActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Shiyu.Voice" />
    </application>

</manifest>
