# 构建产物
build/
.gradle/
.kotlin/
*.apk

# 签名凭据（绝不入库）
keystore/
keystore.properties

# 出厂预置配置（含真实 API Key，绝不入库）
# 仓库里放的是 preset_config.example.json；要跑本地构建就复制它并填 Key
app/src/main/assets/preset_config.json

# 本机路径
local.properties

# IDE
.idea/
*.iml

# 真机抓的日志与临时分析脚本不入库
.workbuddy/*.log
.workbuddy/*.py
# 排障用的音频样本与 uiautomator dump（曾经误入库过一个 2.2MB 的 wav）
.workbuddy/*.ogg
.workbuddy/*.wav
.workbuddy/*.pcm
.workbuddy/*.mp3
.workbuddy/ui*.xml
